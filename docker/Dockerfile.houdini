# Must match the Houdini build's Python, e.g. Houdini 22.0 -> 3.13, Houdini 20.5/21.0 -> 3.11
ARG PYTHON_VER=3.13

# FIRST STAGE: Download Houdini
FROM python:${PYTHON_VER}-slim-trixie AS houdini-downloader
ARG SIDEFX_SECRET
ARG SIDEFX_CLIENT
ARG HFS_VER

# Only copy what the download needs, so other changes don't invalidate the cached download.
# `hou_downloa[d]` matches the optional pre-downloaded build, see README.
WORKDIR /code
COPY requirements_hou.txt scripts/hou_install.py scripts/sidefx.py hou_downloa[d] ./

# DOCKER_DL used within the `hou_install.py` script.
ENV DOCKER_DL=true

# If user has downloaded Houdini already then copy it over, otherwise download directly into container.
RUN mkdir /houdini && \
    if [ -d build ]; then \
        echo "Houdini build folder exists. Skipping download." && \
        mv build /houdini/build; \
    else \
        echo "Downloading houdini..." && \
        pip install --no-cache-dir -r requirements_hou.txt && \
        python3 hou_install.py $HFS_VER; \
    fi

# SECOND STAGE: Install and initialize Houdini
FROM python:${PYTHON_VER}-slim-trixie AS houdini-install

RUN apt-get update && \
    apt-get install -y --no-install-recommends procps hostname libgl1 libatomic1 && \
    rm -rf /var/lib/apt/lists/*

COPY --from=houdini-downloader /houdini /houdiniInstaller

ARG EULA_DATE="2021-10-13"
RUN /houdiniInstaller/build/houdini.install --auto-install --install-sidefxlabs --no-install-license \
        --no-install-avahi --no-install-menus --accept-EULA ${EULA_DATE} --make-dir /opt/houdini/build && \
    rm -r /houdiniInstaller

# THIRD STAGE: Copy houdini-install image and un-cache unnecessary installation files
FROM python:${PYTHON_VER}-slim-trixie
ARG PYTHON_VER
COPY --from=houdini-install / /

RUN test -d /opt/houdini/build/houdini/python${PYTHON_VER}libs || \
    { echo "Houdini build does not contain python${PYTHON_VER}libs, set PYTHON_VER to match:"; \
      ls -d /opt/houdini/build/houdini/python*libs; exit 1; }

# Install the required libs for OpenCL, then point OpenCL to the correct implementation.
RUN apt-get update && \
    apt-get install -y --no-install-recommends ocl-icd-libopencl1 && \
    rm -rf /var/lib/apt/lists/* && \
    mkdir -p /etc/OpenCL/vendors && \
    echo "libnvidia-opencl.so.1" > /etc/OpenCL/vendors/nvidia.icd

COPY requirements_app.txt /tmp/
RUN pip install --no-cache-dir -r /tmp/requirements_app.txt && rm /tmp/requirements_app.txt

ARG HFS_VER
ENV HFS_TARGET=$HFS_VER \
    PATH="${PATH}:/opt/houdini/build/houdini/sbin:/opt/houdini/build/bin" \
    PYTHONPATH="/opt/houdini/build/houdini/python${PYTHON_VER}libs"

# Expose all available GPU devices to the docker container.
ENV NVIDIA_VISIBLE_DEVICES=all \
    NVIDIA_DRIVER_CAPABILITIES=compute,utility

# Stop Houdini from conflicting with our drivers!
ENV HOUDINI_USE_HFS_OCL=0 \
    HOUDINI_OCL_DEVICETYPE=GPU

COPY scripts/setup_hserver.sh /root/

WORKDIR /root/hou_webserver
